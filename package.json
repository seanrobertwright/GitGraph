{
  "name": "gitgraph-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:docs": "pnpm --filter docs dev",
    "dev:consumer": "pnpm --filter consumer-app dev -p 3100",
    "build:docs": "pnpm --filter docs build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/oxide": "4.0.0",
      "@tailwindcss/node": "4.0.0"
    }
  }
}
